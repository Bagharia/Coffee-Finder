# Port d'écoute de l'API
PORT=3000

# Base de données MySQL / MariaDB
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=spotheplace

# Secret de signature des jetons JWT.
# Obligatoire : le serveur refuse de démarrer sans. Aucun repli dans le code.
# Générer une valeur longue et aléatoire : openssl rand -base64 48
JWT_SECRET=

# Origine autorisée par CORS (l'URL du front).
# Obligatoire en production, sinon l'API se replierait sur localhost:5173.
FRONTEND_URL=http://localhost:5173

# development | production
NODE_ENV=development

# Mettre à 1 uniquement si l'API tourne derrière un reverse proxy,
# sinon le limiteur de débit se laisse contourner par un en-tête forgé.
TRUST_PROXY=0

# Portée du cookie de session : lax | strict | none
# 'lax' convient si le front et l'API partagent le domaine — en développement
# via le proxy Vite, en production si l'API est un sous-domaine du site.
# Deux domaines distincts imposent 'none', qui exige HTTPS des deux côtés.
COOKIE_SAMESITE=lax
