# Port d'écoute de l'API
PORT=3000

# Base de données MySQL / MariaDB
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=spotheplace

# Connexion chiffrée à la base. Laisser vide en local ; mettre à 1 chez tout
# hébergeur de base managée (Railway, Aiven, Scaleway, PlanetScale…), qui
# refuse les connexions en clair et rejette au handshake sans cette option.
DB_SSL=

# Chemin d'un certificat d'autorité, pour les fournisseurs qui signent avec la
# leur. Inutile quand l'autorité est publique. Ignoré si DB_SSL n'est pas à 1.
DB_SSL_CA=

# Secret de signature des jetons JWT.
# Obligatoire : le serveur refuse de démarrer sans. Aucun repli dans le code.
# Générer une valeur longue et aléatoire : openssl rand -base64 48
JWT_SECRET=

# Origine autorisée par CORS (l'URL du front).
# Obligatoire en production, sinon l'API se replierait sur localhost:5173.
FRONTEND_URL=http://localhost:5173

# development | production
NODE_ENV=development

# 1 si l'API est derrière un reverse proxy, 0 si elle est exposée directement.
# Obligatoire en production : le serveur refuse de démarrer sans valeur, parce
# qu'aucun défaut n'est sûr. À 0 derrière un proxy, req.ip vaut l'adresse du
# proxy et le limiteur de débit range tous les visiteurs ensemble — dix échecs
# de connexion, de n'importe qui, verrouillent le site entier. À 1 sans proxy
# devant, n'importe qui usurpe son adresse via un en-tête X-Forwarded-For forgé.
TRUST_PROXY=0

# Portée du cookie de session : lax | strict | none
# 'lax' convient si le front et l'API partagent le domaine — en développement
# via le proxy Vite, en production si l'API est un sous-domaine du site.
# Deux domaines distincts imposent 'none', qui exige HTTPS des deux côtés.
COOKIE_SAMESITE=lax

# Contact joint au User-Agent envoyé à Nominatim (géocodage des adresses).
# Leur politique d'usage exige une application identifiable ; une IP de
# datacenter sans contact se fait refuser en 403. Une adresse e-mail ou l'URL
# du site conviennent. À défaut, FRONTEND_URL est utilisée.
NOMINATIM_CONTACT=
